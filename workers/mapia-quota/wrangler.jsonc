{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mapia-quota",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "MAPIA_VISITOR_DAILY_LIMIT": 5,
    "MAPIA_VISITOR_IP_DAILY_LIMIT": 20,
    "MAPIA_FREE_DAILY_LIMIT": 20,
    "MAPIA_PREMIUM_DAILY_LIMIT": 100,
    "MAPIA_GLOBAL_DAILY_LIMIT": 100,
    "MAPIA_ACTOR_RATE_LIMIT": 5,
    "MAPIA_IP_RATE_LIMIT": 20,
    "MAPIA_RATE_WINDOW_SECONDS": 60,
    "MAPIA_ACTOR_CONCURRENCY_LIMIT": 1,
    "MAPIA_GLOBAL_CONCURRENCY_LIMIT": 4,
    "MAPIA_RESERVATION_TTL_SECONDS": 60
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MAPIA_QUOTA",
        "class_name": "MapiaQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MapiaQuota"]
    }
  ]
}
